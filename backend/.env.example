# PostgreSQL connection string
DATABASE_URL=postgres://attendance_user:attendance_pass@localhost:5432/attendance_db

# Secret used to sign admin JWTs - generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (the domain that serves attendance.html)
CORS_ORIGIN=http://localhost:5500,http://localhost:4000

TIMEZONE=Asia/Kolkata

# Public URL that the permanent QR code should encode (where attendance.html is hosted)
PUBLIC_ATTENDANCE_URL=https://YOUR-DOMAIN/attendance.html
